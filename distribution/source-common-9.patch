+import java.util.function.Predicate;
+
+/**
+ * A mount-table snapshot whose most-specific mount determines whether a path supports watching.
+ * Ambiguous mounts exclude their entire subtree, including uniquely listed nested mounts.
+ */
+public final class WatchableFileSystems {
+    public static final WatchableFileSystems UNRESTRICTED = new WatchableFileSystems(Collections.emptyMap(), Collections.emptySet(), fileSystem -> true, true);
+
+    private final Map<Path, FileSystemInfo> fileSystems;
+    private final Set<Path> ambiguousMountPoints;
+    private final Predicate<FileSystemInfo> supported;
+    private final boolean unrestricted;
+
+    private WatchableFileSystems(Map<Path, FileSystemInfo> fileSystems, Set<Path> ambiguousMountPoints, Predicate<FileSystemInfo> supported, boolean unrestricted) {
+        this.fileSystems = Collections.unmodifiableMap(fileSystems);
+        this.ambiguousMountPoints = Collections.unmodifiableSet(ambiguousMountPoints);
+        this.supported = supported;
+        this.unrestricted = unrestricted;
+    }
+
+    public static WatchableFileSystems detect(List<FileSystemInfo> fileSystems, Predicate<FileSystemInfo> supported) {
+        Map<Path, FileSystemInfo> mounts = new HashMap<>();
+        Set<Path> ambiguousMountPoints = new HashSet<>();
+        for (FileSystemInfo fileSystem : fileSystems) {
+            Path mountPoint = fileSystem.getMountPoint().toPath();
+            if (!mountPoint.isAbsolute()) {
+                throw new NativeException("File system mount point is not absolute: " + mountPoint);
+            }
+            Path normalizedMountPoint = mountPoint.normalize();
+            if (ambiguousMountPoints.contains(normalizedMountPoint)) {
+                continue;
+            }
+            if (mounts.putIfAbsent(normalizedMountPoint, fileSystem) != null) {
+                mounts.remove(normalizedMountPoint);
+                ambiguousMountPoints.add(normalizedMountPoint);
+            }
+        }
+        return new WatchableFileSystems(mounts, ambiguousMountPoints, supported, false);
+    }
+
+    public boolean isUnrestricted() {
+        return unrestricted;
+    }
+
+    public boolean isSupported(String absolutePath) {
+        Path path = Paths.get(absolutePath);
+        if (!path.isAbsolute()) {
+            throw new IllegalArgumentException("File system location is not absolute: " + absolutePath);
+        }
+        if (unrestricted) {
+            return true;
+        }
+        FileSystemInfo nearest = null;
+        for (Path candidate = path.normalize(); candidate != null; candidate = candidate.getParent()) {
+            if (ambiguousMountPoints.contains(candidate)) {
+                return false;
+            }
+            if (nearest == null) {
+                nearest = fileSystems.get(candidate);
+            }
+        }
+        return nearest != null && supported.test(nearest);
+    }
+
+    /**
+     * Returns roots requiring conservative invalidation after the mount table changes.
+     * A change between unrestricted and detected modes requires full invalidation by the caller.
+     */
+    public FileHierarchySet changedMountPointsSince(WatchableFileSystems previous) {
+        if (unrestricted != previous.unrestricted) {
+            throw new IllegalArgumentException("Watching mode changes require full invalidation");
+        }
+        Set<Path> mountPoints = new HashSet<>(fileSystems.keySet());
+        mountPoints.addAll(previous.fileSystems.keySet());
+        mountPoints.addAll(ambiguousMountPoints);
+        mountPoints.addAll(previous.ambiguousMountPoints);
+        FileHierarchySet changed = FileHierarchySet.empty();
+        for (Path mountPoint : mountPoints) {
+            boolean ambiguityChanged = ambiguousMountPoints.contains(mountPoint) != previous.ambiguousMountPoints.contains(mountPoint);
+            if (ambiguityChanged || !sameFileSystem(fileSystems.get(mountPoint), previous.fileSystems.get(mountPoint))) {
+                changed = changed.plus(mountPoint.toFile());
+            }
+        }
+        return changed;
+    }
+
+    private static boolean sameFileSystem(FileSystemInfo current, FileSystemInfo previous) {
+        return current == previous || (current != null && previous != null
+            && Objects.equals(current.getDeviceName(), previous.getDeviceName())
+            && Objects.equals(current.getFileSystemType(), previous.getFileSystemType())
+            && current.isRemote() == previous.isRemote());
+    }
+}
