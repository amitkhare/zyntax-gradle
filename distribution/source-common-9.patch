+package org.gradle.internal.watch.vfs
+
+import net.rubygrapefruit.platform.NativeException
+import net.rubygrapefruit.platform.file.FileSystemInfo
+import net.rubygrapefruit.platform.internal.DefaultFileSystemInfo
+import spock.lang.Specification
+
+import java.nio.file.Path
+import java.nio.file.Paths
+
+class WatchableFileSystemsTest extends Specification {
+    private static final Path ROOT = Paths.get("mount-policy-test").toAbsolutePath()
+
+    def "most specific mount preserves supported islands and unsupported nested mounts"() {
+        def policy = detect([
+            fs("root", ROOT, "unsupported"),
+            fs("data", ROOT.resolve("data")),
+            fs("nested", ROOT.resolve("data/nested"), "unsupported"),
+            fs("island", ROOT.resolve("data/nested/island")),
+        ])
+
+        expect:
+        !policy.isSupported(ROOT.toString())
+        !policy.isSupported(ROOT.resolve("sibling/file").toString())
+        policy.isSupported(ROOT.resolve("data/file").toString())
+        !policy.isSupported(ROOT.resolve("data/nested/file").toString())
+        policy.isSupported(ROOT.resolve("data/nested/island/file").toString())
+        !policy.isUnrestricted()
+    }
+
+    def "remote mount overrides a supported ancestor"() {
+        def policy = detect([
+            fs("root", ROOT),
+            fs("remote", ROOT.resolve("remote"), "supported", true),
+        ])
+
+        expect:
+        policy.isSupported(ROOT.resolve("local").toString())
+        !policy.isSupported(ROOT.resolve("remote/file").toString())
+    }
+
+    def "mount matching is component wise and normalizes absolute paths"() {
+        def policy = detect([fs("data", ROOT.resolve("unused/../data"))])
+
+        expect:
+        policy.isSupported(ROOT.resolve("data").toString())
+        policy.isSupported(ROOT.resolve("data/sub/../file").toString())
+        !policy.isSupported(ROOT.resolve("database/file").toString())
+        !policy.isSupported(ROOT.toString())
+    }
+
+    def "empty table and paths outside known mounts are unsupported"() {
+        expect:
+        !detect([]).isSupported(ROOT.toString())
+        !detect([fs("data", ROOT.resolve("data"))]).isSupported(ROOT.resolve("other").toString())
+        WatchableFileSystems.UNRESTRICTED.isSupported(ROOT.toString())
+        WatchableFileSystems.UNRESTRICTED.isUnrestricted()
+    }
+
+    def "relative mount metadata fails closed"() {
+        when:
+        detect([fs("relative", Paths.get("relative/../mount"))])
+
+        then:
+        def failure = thrown(NativeException)
+        failure.message.contains("not absolute")
+    }
+
+    def "relative query paths are rejected in either mode"() {
+        when:
+        policy.isSupported("relative/path")
+
+        then:
+        thrown(IllegalArgumentException)
+
+        where:
+        policy << [detect([]), WatchableFileSystems.UNRESTRICTED]
+    }
+
+    def "ambiguous mounts exclude nested unique mounts without affecting unrelated paths in either order"() {
+        def first = fs("first", ROOT.resolve("data"))
+        def second = fs("second", ROOT.resolve("other/../data"), "unsupported")
+        def policy = detect([
+            fs("root", ROOT),
+            fs("nested", ROOT.resolve("data/nested")),
+            fs("sibling", ROOT.resolve("sibling")),
+        ] + (reverse ? [second, first] : [first, second]))
+
+        expect:
+        !policy.isSupported(ROOT.resolve("data").toString())
+        !policy.isSupported(ROOT.resolve("data/file").toString())
+        !policy.isSupported(ROOT.resolve("data/nested/file").toString())
+        policy.isSupported(ROOT.resolve("sibling/file").toString())
+        policy.isSupported(ROOT.resolve("database/file").toString())
+        policy.isSupported(ROOT.toString())
+
+        where:
+        reverse << [false, true]
+    }
+
+    def "identical duplicate rows stay ambiguous after additional rows"() {
+        def mount = fs("same", ROOT.resolve("data"))
+        def policy = detect([fs("root", ROOT), mount, mount] + additionalRows)
+
+        expect:
+        !policy.isSupported(ROOT.resolve("data/file").toString())
+        policy.isSupported(ROOT.resolve("sibling/file").toString())
+
+        where:
+        additionalRows << [[], [fs("same", ROOT.resolve("data"))], [fs("third", ROOT.resolve("data"))]]
+    }
+
+    def "equivalent reordered mount records do not invalidate anything"() {
+        def previous = detect([fs("root", ROOT), fs("child", ROOT.resolve("child"))])
+        def current = detect([fs("child", ROOT.resolve("unused/../child")), fs("root", ROOT)])
+
+        expect:
+        current.changedMountPointsSince(previous).empty
+        previous.changedMountPointsSince(current).empty
+    }
+
+    def "added removed and changed mount identities invalidate their descendants"() {
+        def previous = detect([fs("root", ROOT)] + before)
+        def current = detect([fs("root", ROOT)] + after)
+        def changed = current.changedMountPointsSince(previous)
+
+        expect:
+        changed.contains(ROOT.resolve("child").toFile())
+        changed.contains(ROOT.resolve("child/descendant").toFile())
+        !changed.contains(ROOT.resolve("sibling").toFile())
+        !changed.contains(ROOT.toFile())
+
+        where:
+        before                                    | after
+        []                                        | [fs("new", ROOT.resolve("child"))]
+        [fs("old", ROOT.resolve("child"))]        | []
+        [fs("old", ROOT.resolve("child"))]        | [fs("new", ROOT.resolve("child"))]
+        [fs("same", ROOT.resolve("child"))]       | [fs("same", ROOT.resolve("child"), "unsupported")]
+        [fs("same", ROOT.resolve("child"))]       | [fs("same", ROOT.resolve("child"), "supported", true)]
+    }
+
+    def "a moved mount invalidates both its old and new paths"() {
+        def previous = detect([fs("device", ROOT.resolve("old"))])
+        def current = detect([fs("device", ROOT.resolve("new"))])
+        def changed = current.changedMountPointsSince(previous)
+
+        expect:
+        changed.contains(ROOT.resolve("old/file").toFile())
+        changed.contains(ROOT.resolve("new/file").toFile())
+        !changed.contains(ROOT.resolve("other/file").toFile())
+    }
+
+    def "transitions between ambiguous and absent or unique mounts invalidate only that subtree"() {
+        def unambiguous = detect([fs("root", ROOT)] + rows)
+        def ambiguous = detect([
+            fs("root", ROOT),
+            fs("first", ROOT.resolve("child")),
+            fs("second", ROOT.resolve("child")),
+        ])
+        def changed = reverse ? unambiguous.changedMountPointsSince(ambiguous) : ambiguous.changedMountPointsSince(unambiguous)
+
+        expect:
+        changed.contains(ROOT.resolve("child").toFile())
+        changed.contains(ROOT.resolve("child/descendant").toFile())
+        !changed.contains(ROOT.resolve("sibling").toFile())
+        !changed.contains(ROOT.toFile())
+
+        where:
+        rows                                 | reverse
+        []                                   | false
+        []                                   | true
+        [fs("first", ROOT.resolve("child"))] | false
+        [fs("first", ROOT.resolve("child"))] | true
+    }
+
+    def "mount table is independent of subsequent input list changes"() {
+        def rows = [fs("root", ROOT)]
+        def policy = detect(rows)
+        rows.clear()
+
+        expect:
+        policy.isSupported(ROOT.resolve("file").toString())
+    }
+
+    def "mode changes require full invalidation by the caller"() {
+        when:
+        current.changedMountPointsSince(previous)
+
+        then:
+        thrown(IllegalArgumentException)
+
+        where:
+        current                           | previous
+        WatchableFileSystems.UNRESTRICTED | detect([])
+        detect([])                        | WatchableFileSystems.UNRESTRICTED
+    }
+
+    def "unrestricted mode is unchanged"() {
+        expect:
+        WatchableFileSystems.UNRESTRICTED.changedMountPointsSince(WatchableFileSystems.UNRESTRICTED).empty
+    }
+
+    private static WatchableFileSystems detect(List<FileSystemInfo> fileSystems) {
+        WatchableFileSystems.detect(fileSystems, { it.fileSystemType == "supported" && !it.remote })
+    }
+
+    private static FileSystemInfo fs(String device, Path mount, String type = "supported", boolean remote = false) {
+        new DefaultFileSystemInfo(mount.toFile(), type, device, remote, null)
+    }
+}
