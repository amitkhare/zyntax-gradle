+        expect:
+        changed.contains(ROOT.resolve("child").toFile())
+        changed.contains(ROOT.resolve("child/descendant").toFile())
+        !changed.contains(ROOT.resolve("sibling").toFile())
+        !changed.contains(ROOT.toFile())
+
+        where:
+        before                                    | after
+        []                                        | [fs("new", ROOT.resolve("child"))]
+        [fs("old", ROOT.resolve("child"))]        | []
+        [fs("old", ROOT.resolve("child"))]        | [fs("new", ROOT.resolve("child"))]
+        [fs("same", ROOT.resolve("child"))]       | [fs("same", ROOT.resolve("child"), "unsupported")]
+        [fs("same", ROOT.resolve("child"))]       | [fs("same", ROOT.resolve("child"), "supported", true)]
+    }
+
+    def "a moved mount invalidates both its old and new paths"() {
+        def previous = detect([fs("device", ROOT.resolve("old"))])
+        def current = detect([fs("device", ROOT.resolve("new"))])
+        def changed = current.changedMountPointsSince(previous)
+
+        expect:
+        changed.contains(ROOT.resolve("old/file").toFile())
+        changed.contains(ROOT.resolve("new/file").toFile())
+        !changed.contains(ROOT.resolve("other/file").toFile())
+    }
+
+    def "transitions between ambiguous and absent or unique mounts invalidate only that subtree"() {
+        def unambiguous = detect([fs("root", ROOT)] + rows)
+        def ambiguous = detect([
+            fs("root", ROOT),
+            fs("first", ROOT.resolve("child")),
+            fs("second", ROOT.resolve("child")),
+        ])
+        def changed = reverse ? unambiguous.changedMountPointsSince(ambiguous) : ambiguous.changedMountPointsSince(unambiguous)
+
+        expect:
+        changed.contains(ROOT.resolve("child").toFile())
+        changed.contains(ROOT.resolve("child/descendant").toFile())
+        !changed.contains(ROOT.resolve("sibling").toFile())
+        !changed.contains(ROOT.toFile())
+
+        where:
+        rows                                 | reverse
+        []                                   | false
+        []                                   | true
+        [fs("first", ROOT.resolve("child"))] | false
+        [fs("first", ROOT.resolve("child"))] | true
+    }
+
+    def "mount table is independent of subsequent input list changes"() {
+        def rows = [fs("root", ROOT)]
+        def policy = detect(rows)
+        rows.clear()
+
+        expect:
+        policy.isSupported(ROOT.resolve("file").toString())
+    }
+
+    def "mode changes require full invalidation by the caller"() {
+        when:
+        current.changedMountPointsSince(previous)
+
+        then:
+        thrown(IllegalArgumentException)
+
+        where:
+        current                           | previous
+        WatchableFileSystems.UNRESTRICTED | detect([])
+        detect([])                        | WatchableFileSystems.UNRESTRICTED
+    }
+
+    def "unrestricted mode is unchanged"() {
+        expect:
+        WatchableFileSystems.UNRESTRICTED.changedMountPointsSince(WatchableFileSystems.UNRESTRICTED).empty
+    }
+
+    private static WatchableFileSystems detect(List<FileSystemInfo> fileSystems) {
+        WatchableFileSystems.detect(fileSystems, { it.fileSystemType == "supported" && !it.remote })
+    }
+
+    private static FileSystemInfo fs(String device, Path mount, String type = "supported", boolean remote = false) {
+        new DefaultFileSystemInfo(mount.toFile(), type, device, remote, null)
+    }
+}
