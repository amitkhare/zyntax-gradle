+        SupportedSnapshotsVisitor(WatchableFileSystems fileSystems) {
+            this.fileSystems = fileSystems;
+        }
+
+        @Override
+        public SnapshotVisitResult visitEntry(FileSystemLocationSnapshot snapshot) {
+            if (!(snapshot instanceof DirectorySnapshot)) {
+                if (fileSystems.isSupported(snapshot.getAbsolutePath())) {
+                    retain(snapshot);
+                } else {
+                    excludedContent = true;
+                    if (!directories.isEmpty()) {
+                        directories.peek().complete = false;
+                    }
+                }
+            }
+            return SnapshotVisitResult.CONTINUE;
+        }
+
+        @Override
+        public void enterDirectory(DirectorySnapshot snapshot) {
+            boolean supported = fileSystems.isSupported(snapshot.getAbsolutePath());
+            excludedContent |= !supported;
+            directories.push(new RetainedDirectory(supported));
+        }
+
+        @Override
+        public void leaveDirectory(DirectorySnapshot snapshot) {
+            RetainedDirectory directory = directories.pop();
+            if (directory.complete) {
+                retain(snapshot);
+            } else if (directories.isEmpty()) {
+                retained.addAll(directory.children);
+            } else {
+                directories.peek().complete = false;
+                directories.peek().children.addAll(directory.children);
+            }
+        }
+
+        private void retain(FileSystemLocationSnapshot snapshot) {
+            (directories.isEmpty() ? retained : directories.peek().children).add(snapshot);
+        }
+
+        private static class RetainedDirectory {
+            private boolean complete;
+            private final List<FileSystemLocationSnapshot> children = new ArrayList<>();
+
