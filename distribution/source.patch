+    private static class SupportedSnapshotsVisitor implements FileSystemSnapshotHierarchyVisitor {
+        private final WatchableFileSystems fileSystems;
+        private final Deque<RetainedDirectory> directories = new ArrayDeque<>();
+        private final List<FileSystemLocationSnapshot> retained = new ArrayList<>();
+        private boolean excludedContent;
