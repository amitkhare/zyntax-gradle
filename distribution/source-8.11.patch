+class WatchableHierarchiesTest extends Specification implements TestSnapshotFixture {
+    def "retains original supported islands and discards mixed hashes and orphan metadata"() {
+        def path = { String relative -> Paths.get("watchable-hierarchies-test").toAbsolutePath().resolve(relative).toString() }
+        def stable = directory(path("root/volume/stable"), [regularFile(path("root/volume/stable/keep"))])
+        def island = directory(path("root/volume/temporary/island"), [regularFile(path("root/volume/temporary/island/keep"))])
+        def rejected = regularFile(path("root/volume/temporary/discard"))
+        def remote = regularFile(path("root/volume/remote/discard"))
+        def original = directory(path("root/volume"), [
+            stable,
+            directory(path("root/volume/temporary"), [rejected, island]),
+            directory(path("root/volume/remote"), [remote])
+        ])
+        def fileSystems = WatchableFileSystems.detect([
+            new DefaultFileSystemInfo(new File(path("root")), "erofs", "root", false, null),
+            new DefaultFileSystemInfo(new File(path("root/volume")), "f2fs", "local", false, null),
+            new DefaultFileSystemInfo(new File(path("root/volume/temporary")), "tmpfs", "temporary", false, null),
+            new DefaultFileSystemInfo(new File(island.absolutePath), "f2fs", "local", false, null),
+            new DefaultFileSystemInfo(new File(path("root/volume/remote")), "ext4", "remote", true, null)
+        ], { !it.remote && it.fileSystemType in ["f2fs", "ext4"] })
+        def probes = Stub(FileWatcherProbeRegistry) {
+            unprovenHierarchies() >> { Stream.empty() }
+        }
+        def hierarchies = new WatchableHierarchies(probes, { false })
+        def invalidator = { root, action -> action.apply(root, SnapshotHierarchy.NodeDiffListener.NOOP) } as WatchableHierarchies.Invalidator
+        def empty = buildHierarchy(CASE_SENSITIVE, [])
+        hierarchies.removeUnwatchableContentOnBuildStart(empty, invalidator, WatchMode.DEFAULT, fileSystems)
+        hierarchies.registerWatchableHierarchy(new File(path("root/volume")), empty)
+        def root = buildHierarchy(CASE_SENSITIVE, [original])
+        root = root.store(path("orphan"), MetadataSnapshot.DIRECTORY, SnapshotHierarchy.NodeDiffListener.NOOP)
+        assert root.findMetadata(path("orphan")).present
+
+        when:
+        root = hierarchies.removeUnwatchableContentBeforeBuildFinished(root, { true }, Integer.MAX_VALUE, fileSystems, invalidator)
+        root = hierarchies.removeUnwatchableContentAfterBuildFinished(root, invalidator)
+
+        then:
+        root.findSnapshot(stable.absolutePath).get().is(stable)
+        root.findSnapshot(island.absolutePath).get().is(island)
+        !root.findSnapshot(original.absolutePath).present
+        !root.findSnapshot(path("root/volume/temporary")).present
+        !root.findMetadata(rejected.absolutePath).present
+        !root.findMetadata(remote.absolutePath).present
+        !root.findMetadata(path("orphan")).present
+
+        when:
+        root = buildHierarchy(CASE_SENSITIVE, [directory(path("root"), [original])])
+        root = hierarchies.removeUnwatchableContentBeforeBuildFinished(root, { true }, Integer.MAX_VALUE, fileSystems, invalidator)
+        root = hierarchies.removeUnwatchableContentAfterBuildFinished(root, invalidator)
+
+        then:
+        // A complete snapshot above the registered hierarchy was not watched as a root.
+        !root.rootSnapshots().findAny().present
+        !root.findMetadata(stable.absolutePath).present
+        !root.findMetadata(island.absolutePath).present
+    }
